    {
      "id": "image4",
      "filename": "image4_gen_query.png",
      "type": "terminal",
      "lines": [
        { "prompt": "cat gen_query.py" },
        "IP_packet = IP(dst=\"10.2.6.53\", src=\"10.2.6.1\")",
        "UDP_packet = UDP(dport=53, sport=12345, chksum=0)",
        "Qdsec = DNSQR(qname='twysw.example.com')",
        "dns = DNS(id=0xAAAA, qr=0, qdcount=1, ancount=0, nscount=0, arcount=0, qd=Qdsec)",
        "with open('ip_req.bin', 'wb') as f: f.write(bytes(IP_packet/UDP_packet/dns))",
        { "prompt": "python3 gen_query.py && ls -lh ip_req.bin" },
        "Created ip_req.bin successfully.",
        "-rw-r--r-- 1 root root 63 Oct 27 07:21 ip_req.bin",
